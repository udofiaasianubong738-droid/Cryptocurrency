{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cryptocurrency",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "cryptoinvest.com",
      "custom_domain": true
    },
    {
      "pattern": "admin.cryptoinvest.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "previews": {}
}
