{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cryptocurrency-admin",
  "account_id": "72b10490e65a914465cc281cb3cb7ed1",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "admin.cryptoinvest.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
