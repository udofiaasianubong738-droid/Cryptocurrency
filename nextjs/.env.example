# Copy to .env.local for local development. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
# Prefer a Supabase publishable key. The legacy anon key is accepted as a fallback.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Cloudflare Turnstile site key. The matching secret must be configured
# privately in Supabase Auth CAPTCHA settings; never put that secret here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Safety gate: keep disabled in all environments until independent review is complete.
FINANCIAL_OPERATIONS_ENABLED=false
